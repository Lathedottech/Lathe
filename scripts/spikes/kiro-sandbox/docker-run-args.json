{
  "comment": "Hardening flags for every P0-04 spike container. Mode-specific flags (credential, network) are added by the caller.",
  "args": [
    "run",
    "--rm",
    "-i",
    "--user",
    "10001:10001",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "--read-only",
    "--tmpfs",
    "/tmp:rw,noexec,nosuid,size=64m",
    "--tmpfs",
    "/home/lathe:rw,nosuid,size=256m,uid=10001,gid=10001",
    "--pids-limit",
    "256",
    "--memory",
    "2g",
    "--cpus",
    "2"
  ]
}
